# Supabase — Project Settings > API no painel do projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (produção: https://seu-dominio.com).
# Usada em links de e-mail (reset de senha, pedido de avaliação).
# Sem isso os links caem em localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — resend.com/api-keys
RESEND_API_KEY=
# Remetente. Em modo sandbox (domínio não verificado), use onboarding@resend.dev.
RESEND_FROM=Kairos Barbearia <onboarding@resend.dev>
# Em modo sandbox o Resend só entrega pro e-mail dono da conta; e-mails
# reais de clientes são redirecionados pra cá (ver resolverDestinatario em lib/emails.tsx).
RESEND_TEST_EMAIL=

# Segredo compartilhado com o cron de lembretes (app/api/cron/lembretes/route.ts).
# Na Vercel, defina essa env e o Cron manda ela automaticamente no header.
CRON_SECRET=
